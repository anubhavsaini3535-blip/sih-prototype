# Google Gemini API Key (Required for AI field deduction and vision fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: PostgreSQL Database URL (Leave empty to use default SQLite)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: Custom JWT Secret Key
# JWT_SECRET_KEY=your-secure-random-secret-key-32-chars-long
